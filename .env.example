PORT=3100
MONGO_URI=mongodb://127.0.0.1:27017/lms_db
JWT_SECRET=replace-with-a-long-random-secret
# The seed must use a dedicated local database; override MONGO_URI accordingly.
SEED_DB_NAME=lms_seed_test
SEED_TRAINER_PASSWORD=replace-with-trainer-password
SEED_LEARNER_PASSWORD=replace-with-learner-password
SEED_ADMIN_PASSWORD=replace-with-admin-password
INACTIVE_DAYS=30
# Log is the default driver. No SMTP connection is made in this mode.
EMAIL_DRIVER=log
# Required only when EMAIL_DRIVER=smtp. Supply real credentials outside Git.
SMTP_HOST=smtp.example.test
SMTP_PORT=587
SMTP_USER=replace-with-smtp-user
SMTP_PASS=replace-with-smtp-password
SMTP_FROM=no-reply@example.test

# Optional Docker Compose host ports and database name.
API_PORT=3101
MONGO_PORT=27018
MONGO_DB_NAME=lms_db
